{% extends "police_station.html.j2" %}
{% from "components/buttons.html.j2" import render_add_clue_button %}

{% block police_station_results %}
  {% if data != None %}
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Phone Number</th>
          <th>License Plate</th>
          <th>Passport Number</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>{{ data.name }}</td>
          <td>{{ data.phone_number }}</td>
          <td>{{ data.license_plate }}</td>
          <td>{{ data.passport_number }}</td>
          <td>
            {{render_add_clue_button(
              "people of interest",
              "name: " ~ data.name ~ " | ph: " ~ data.phone_number ~ " | license plate: " ~ 
                data.license_plate ~ " | passport: " ~ data.passport_number
            )}}
          </td>
        </tr>
      </tbody>
    </table>
  {% else %}
    <p>No results found - try again!</p>
  {% endif %}
{% endblock %}