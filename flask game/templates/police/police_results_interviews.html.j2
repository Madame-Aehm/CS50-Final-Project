{% extends "police_station.html.j2" %}
{% from "components/buttons.html.j2" import render_add_clue_button %}

{% block police_station_results %}
  {% if data != None %}
      {% if data|count > 0 %}
      <h3>Results:</h3>
        <ul class="extend-bottom">
          {% for row in data %}
            <li class="pixel-box list-item">
              {{render_add_clue_button(
                "interviews",
                row.day ~ "-" ~ row.month ~ "-" ~ row.year ~ ", " ~ row.name ~ ": " ~ row.transcript
              )}}
              <p>When: {{ row.day }}-{{ row.month }}-{{ row.year }}</p>
              <p>Who: {{ row.name }}</p>
              <p>{{ row.transcript }}</p>
            </li>
          {% endfor %}
        </ul>
      {% else %}
          <p>No results found - try again!</p>
      {% endif %}
  {% endif %}
{% endblock %}