{% extends "airport/airport_lookup.html.j2" %}
{% from "components/buttons.html.j2" import render_add_clue_button %}

{% block airport_lookup_result %}
  {% if data != None %}
    {% if data|count > 0 %}
      <h2>Flight Passengers:</h2>
      <table>
        <thead>
          <tr>
            <th>Flight #</th>
            <th>Passport</th>
            <th>Seat</th>
          </tr>
        </thead>
        <tbody>
          {% for row in data %}
            <tr>
              <td>{{ row.flight_id }}</td>
              <td>{{ row.passport_number }}</td>
              <td>{{ row.seat }}</td>
              <td>
                {{render_add_clue_button(
                  "flight passengers",
                  "Flight " ~ row.flight_id ~ ": passport " ~ row.passport_number ~ " assigned seat " ~ row.seat
                )}}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p>No results found.</p>
    {% endif %}
  {% endif %}
{% endblock %}